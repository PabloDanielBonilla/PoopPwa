# ─────────────────────────────────────────────────────────────
# poop.lol — Vercel environment variables (public, safe for the browser)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL="https://poop.lol"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets — never add these to Vercel.
# Copy this file to .env.functions and fill in the server-side values.
# SUPABASE_SERVICE_ROLE_KEY is injected automatically by Supabase.
# Set them with: npx supabase secrets set --env-file .env.functions
# Generate the VAPID pair with: node scripts/generate-vapid-keys.mjs --write
# ─────────────────────────────────────────────────────────────

APP_URL="https://poop.lol"
ALLOWED_ORIGINS="https://poop.lol,http://localhost:3000"

VAPID_KEYS_JSON='{"publicKey":{"kty":"EC","crv":"P-256","x":"...","y":"..."},"privateKey":{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}}'
VAPID_SUBJECT="mailto:admin@poop.lol"

# Random value shared only by the Database Webhook and send-push.
PUSH_WEBHOOK_SECRET="generate-a-long-random-value"

POLAR_ACCESS_TOKEN="polar_oat_..."
POLAR_PRODUCT_ID_ROOM_MONTHLY="prod_..."
POLAR_WEBHOOK_SECRET="whsec_..."
POLAR_SERVER="production"
